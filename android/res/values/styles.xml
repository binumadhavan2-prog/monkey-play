<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The settings screen keeps its own light look, even when the phone (or MIUI) would force it dark. -->
    <style name="MonkeyTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:colorAccent">@color/icon_bg</item>
    </style>
</resources>
